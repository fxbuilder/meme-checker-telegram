# SCAN_MODE=mock  → labeled [mock] fixtures, no network
# SCAN_MODE=live  → real market data + risk indicators (see docs/card-ui-and-chains.md)
SCAN_MODE=mock
# Card render mode: compact (default) or detailed
CARD_VIEW=compact
# Chain assumed for a bare 0x… address. See /chains in the bot.
DEFAULT_EVM_CHAIN=bsc
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to run OWNER-only commands.
OWNER_USER_IDS=
# Comma-separated chat ids the bot will answer in (staging allowlist).
ALLOWED_CHAT_IDS=
# Signing secret for First Caller deep links. WITHOUT IT links do not survive a
# restart; the bot warns on startup. Any long random string.
CALLER_LINK_SECRET=
TELEGRAM_TEST_GROUP_ID=
CORE_API_BASE_URL=
CORE_API_TOKEN=
TOKEN_PAGE_BASE_URL=
# Independent Premium/VIP destination URL (omit to disable the button)
PREMIUM_URL=
# Optional custom emoji theme: JSON map of standard→custom_emoji_id
# e.g. {"🚀":"5368324170671202286","🪙":"5368324170671202287"}
# Requires Telegram Premium on the bot owner account to render.
# Leave empty to use standard emoji (safe default).
EMOJI_THEME=

# --- X / KOL intelligence (OPTIONAL) ---
# X search is a Premium website feature. The bot shows cached previews only, and
# ordinary scans/commands/observer make ZERO billable X requests.
# Set this ONLY for OWNER-controlled research. Never printed or logged.
GETXAPI_KEY=
# Optional host override for GetXAPI (default https://api.getxapi.com)
# GETXAPI_BASE_URL=
# Alternative provider, used only when GETXAPI_KEY is absent or X_PROVIDER=sorsa.
SORSA_API_KEY=
# Explicit backend choice: getxapi | sorsa
# X_PROVIDER=getxapi
# Persistent daily cap on billable X searches (staging default 20).
RESEARCH_X_BUDGET=20
# Where the budget window is remembered across restarts.
# RESEARCH_BUDGET_PATH=./data/research-budget.json

# --- Behaviour tuning ---
# Minimum gap between Refresh taps on one card (ms)
REFRESH_COOLDOWN_MS=8000
# Per-scan research ceiling (ms). Research never blocks the market card.
# RESEARCH_TIMEOUT_MS=2500
# Enable/disable research enrichment on scans: on | off
# RESEARCH_ON_SCAN=on
# Optional Solana RPC override (default: public mainnet-beta)
# SOLANA_RPC_URL=

# --- Phase 2: call tracking ---
# Durable call history file. Defaults to ./data/calls.json
# CALLS_DB_PATH=
# Interpreter used for the PnL PNG card (defaults to python, then python3)
# PNL_PYTHON=
